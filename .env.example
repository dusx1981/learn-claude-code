# API Key (required)
# Get yours at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-dashscope-xxx

# Model ID (required)
MODEL_ID=qwen-max

# Base URL (optional, for OpenAI-compatible providers)
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

